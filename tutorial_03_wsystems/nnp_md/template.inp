MYPATH

&GLOBAL
  PROJECT nnp_md
  PRINT_LEVEL LOW
  RUN_TYPE MD
&END GLOBAL

&MOTION
  &MD
    STEPS 2000
    TIMESTEP [fs] 0.5
    ENSEMBLE NVT
    TEMPERATURE 300.0
    ANGVEL_TOL 1.0E-8
    COMVEL_TOL 1.0E-8
    &THERMOSTAT
      TYPE NOSE
      &NOSE
        TIMECON [fs] 50
      &END NOSE
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 5
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 5
      &END EACH
    &END VELOCITIES
    &FORCES
      &EACH
        MD 5
      &END EACH
    &END FORCES
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD  NNP
  &NNP
    NNP_INPUT_FILE_NAME ${PATH}/nnp-001/input.nn
    SCALE_FILE_NAME  ${PATH}/nnp-001/scaling.data
    &MODEL
      WEIGHTS ${PATH}/nnp-001/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-002/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-003/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-004/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-005/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-006/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-007/weights
    &END MODEL
    &MODEL
      WEIGHTS ${PATH}/nnp-008/weights
    &END MODEL
    &PRINT
      &ENERGIES OFF
      &END ENERGIES
    &END PRINT
  &END NNP
  &SUBSYS
    &TOPOLOGY
      CONN_FILE_FORMAT OFF
      COORD_FILE_NAME ${PATH}/nnp-001/input.pdb
      COORD_FILE_FORMAT PDB
      &CENTER_COORDINATES T
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &CELL
      CELL_FILE_FORMAT CIF
      CELL_FILE_NAME ${PATH}/nnp-001/input.cif
      PERIODIC XYZ
    &END CELL
  &END SUBSYS
&END FORCE_EVAL

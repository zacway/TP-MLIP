@SET PATH training/model

&GLOBAL
  PROJECT zundel
  PRINT_LEVEL LOW
  RUN_TYPE MD
&END GLOBAL

&MOTION
  &MD
    STEPS 100000
    TIMESTEP [fs] 0.5
    ENSEMBLE NVT
    TEMPERATURE 300.0
    ANGVEL_TOL 1.0E-8
    COMVEL_TOL 1.0E-8
    &THERMOSTAT
      REGION MASSIVE
      TYPE CSVR
      &CSVR
        TIMECON [fs] 200
      &END CSVR
    &END THERMOSTAT
  &END MD
  &PRINT
    &TRAJECTORY
      &EACH
        MD 5
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 5
      &END EACH
    &END VELOCITIES
    &FORCES
      &EACH
        MD 5
      &END EACH
    &END FORCES
    &RESTART OFF
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD  NNP
  &NNP
    NNP_INPUT_FILE_NAME ${PATH}/nnp-000/input.nn
    SCALE_FILE_NAME  ${PATH}/nnp-000/scaling.data
    &MODEL
      WEIGHTS ${PATH}/nnp-000/weights
    &END MODEL
    &PRINT
      &ENERGIES SILENT
        &EACH
          MD 1
        &END EACH
      &END ENERGIES
    &END PRINT
  &END NNP
  &SUBSYS
    &TOPOLOGY
      CONN_FILE_FORMAT OFF
      COORD_FILE_NAME zundel.pdb
      COORD_FILE_FORMAT PDB
      &CENTER_COORDINATES T
      &END CENTER_COORDINATES
    &END TOPOLOGY
    &CELL
      ABC 10.0 10.0 10.0
      PERIODIC NONE
    &END CELL
  &END SUBSYS
&END FORCE_EVAL
